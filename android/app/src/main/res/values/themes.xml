<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AP0DL" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/anyomi_bg</item>
        <item name="android:colorAccent">@color/anyomi_blue</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/anyomi_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.AP0DL.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/anyomi_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.AP0DL</item>
    </style>
</resources>